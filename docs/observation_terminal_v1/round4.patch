+    lines += ["| model|split | r0 mid2d p50 (m) | r0 mid2d p90 | r0 angle p50 (deg) | "
+              "r0 angle p90 | pose dx p50 | dur p50 (s) | exit acc |", "|---|---:|---:|---:|---:|---:|---:|---:|"]
+    for name, entry in rows:
