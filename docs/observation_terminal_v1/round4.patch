+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/experiments/option_prediction_mechanism_v1/phase_c_frozen/contract_score.py b/experiments/option_prediction_mechanism_v1/phase_c_frozen/contract_score.py
