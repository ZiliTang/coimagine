+    own = observed.get("own")
+    if normal is None or own is None:
+        return None
+    segment = observed.get("segment_world")
+    if not segment:
+        return None
+    p0, p1 = segment[0], segment[1]
+    mid = (0.5 * (p0[0] + p1[0]), 0.5 * (p0[1] + p1[1]))
+    obj = (row.get("true") or {}).get("object") or [0.0] * 6
+    speeds = []
