+
+    fig.suptitle("F01 研究动机与当前主线：物理乐观是已有动机，信息乐观与观测条件分支仍待验证",
+                 fontsize=12)
+    paths = save(fig, "F01_motivation_and_mainline")
+    rows = [
+        ["阶段", "完成内容", "证据文件", "关键数字", "状态"],
+        ["Gridworld", "候选序列收益高估诊断", "docs/20261013_1937_研究主线与验证原则_v1 (1).md §3.1",
