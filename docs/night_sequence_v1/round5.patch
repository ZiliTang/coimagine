+                         round(record["object_pose"][0], 5), round(record["object_pose"][1], 5),
+                         round(record["robot_poses"][0][0], 5), round(record["robot_poses"][0][1], 5),
+                         round(record["robot_poses"][1][0], 5), round(record["robot_poses"][1][1], 5)])
